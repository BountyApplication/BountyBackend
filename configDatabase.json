{
    "accounts" : {
        "columns": {
            "userId" : "INTEGER PRIMARY KEY AUTOINCREMENT",
            "firstname" : "VARCHAR(20)",
            "lastname" : "VARCHAR(30)",
            "balance" : "FLOAT",
            "joining" : "DATE",
            "cardId" : "INTEGER",
            "active" : "INTEGER DEFAULT 1",
            "deposit" : "INTEGER DEFAULT 0",
            "note" : "VARCHAR(200)",
            "noteLevel" : "VARCHAR(10)"
        },
        "additional" :""
    },
    "history" : {
        "columns" : {
            "bookingId" : "INTEGER PRIMARY KEY AUTOINCREMENT",
            "userId" : "INTEGER",
            "date" : "DATE",
            "oldBalance" : "FLOAT",
            "newBalance" : "FLOAT",
            "total" : "FLOAT",
            "correction" : "FLOAT",
            "cashPayment" : "FLOAT",
            "productSum" : "FLOAT",
            "products" : "VARCHAR(1500)",
            "donation" : "FLOAT DEFAULT 0"
        },
        "additional" : "FOREIGN KEY (userId) REFERENCES accounts(userId)"
    },
    "products" : {
        "columns" : {
            "productId" : "INTEGER PRIMARY KEY AUTOINCREMENT",
            "name" : "VARCHAR(20)",
            "price" : "FLOAT",
            "place" : "INTEGER",
            "active" : "INTEGER DEFAULT 1",
            "stock" : "INTEGER DEFAULT NULL",
            "deposit" : "INTEGER DEFAULT 0"
        },
        "additional" : ""
    },
    "cards" : {
        "columns" : {
            "cardId" : "INTEGER PRIMARY KEY UNIQUE",
            "userId" : "INTEGER"
        },
        "additional" :"FOREIGN KEY (userId) REFERENCES accounts(userId)"
    },
    "settings" : {
        "columns" : {
            "key" : "VARCHAR(40) PRIMARY KEY",
            "value" : "VARCHAR(100)"
        },
        "additional" : ""
    }
}